{
  "name": "chamabondo-staff-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chamabondo Teacher Check-In, KRA and Scheme Book Management System (offline-first PWA)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "icons": "node scripts/generate-icons.mjs",
    "mock:worker": "msw init public/ --save"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
