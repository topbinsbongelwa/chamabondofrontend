# Base URL of the Chamabondo Teacher Portal API.
# Local development: http://localhost:5000
# Vercel (Project Settings -> Environment Variables): https://chamabondobackend.vercel.app
# Do not add a trailing slash. A trailing /api is also accepted.
VITE_API_URL=http://localhost:5000

# Server-side upstream URL for the Vercel Intelli AI proxy. Do not prefix with VITE_.
INTELLI_AI_API_URL=https://intellli-ai.netlify.app/api/ask

# Optional WhatsApp group invite URL shown on the teacher Updates page.
VITE_WHATSAPP_GROUP_URL=
