# Base URL of the API for local development.
# Production uses the same-origin Vercel proxy configured in vercel.json.
# VITE_API_URL is only used by the local development server.
# A trailing slash is removed automatically, and /api is never doubled.
VITE_API_URL=http://localhost:5000/api

# Server-side upstream URL for the Vercel Intelli AI proxy. Do not prefix with VITE_.
INTELLI_AI_API_URL=https://intellli-ai.netlify.app/api/ask

# Optional WhatsApp group invite URL shown on the teacher Updates page.
VITE_WHATSAPP_GROUP_URL=
